# Shared with docmind-api-service (must match its INTERNAL_API_KEY)
INTERNAL_API_KEY=change-me-long-random-string

# Chat models. Local Ollama; to use OpenAI, remove LLM_BASE_URL and set LLM_API_KEY / models.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
LLM_FAST_MODEL=llama3.2
# OpenAI instead (what the project is tuned on): LLM_BASE_URL= and LLM_API_KEY= left empty (OPENAI_API_KEY is used),
# LLM_MODEL=gpt-5, LLM_FAST_MODEL=gpt-5-mini, LLM_REASONING_EFFORT=low
# For OpenAI reasoning models (gpt-5, o-series): minimal, low (default), medium or high. Ignored by other models.
# LLM_REASONING_EFFORT=low

# Optional: grade evals with a different (stronger) model. Unset = use LLM_MODEL. With LLM_JUDGE_BASE_URL empty it goes to OpenAI
# and uses LLM_JUDGE_API_KEY, or OPENAI_API_KEY when that is empty.
# LLM_JUDGE_MODEL=gpt-5
# LLM_JUDGE_REASONING_EFFORT=low
# LLM_JUDGE_BASE_URL=
# LLM_JUDGE_API_KEY=

# Embeddings (OpenAI). The DB column is vector(1536): keep 1536 unless the schema changes.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional
# Chunking (spec 7.1). Changing these only affects documents processed afterwards (use Reprocess on existing ones).
# CHUNK_TOKENS=500
# CHUNK_OVERLAP_TOKENS=80
LOG_LEVEL=INFO
AI_HOST=127.0.0.1
AI_PORT=8000
LIBREOFFICE_PATH=
