# Shared with docmind-api-service (must match its INTERNAL_API_KEY)
INTERNAL_API_KEY=change-me-long-random-string

# Chat models. Local Ollama; to use OpenAI, remove LLM_BASE_URL and set LLM_API_KEY / models.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
LLM_FAST_MODEL=llama3.2

# Embeddings (OpenAI). The DB column is vector(1536): keep 1536 unless the schema changes.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional
LOG_LEVEL=INFO
AI_HOST=127.0.0.1
AI_PORT=8000
LIBREOFFICE_PATH=
